# Environment Variables for SkillBridge EdTech Agentic RAG
# Local API keys (never commit or paste into Kaggle)

# Google Gemini API Key for Embeddings (google-genai / text-embedding-004)
GOOGLE_API_KEY=

# Groq API Keys (multiple keys recommended for rate-limit handling)
# Free keys available at: https://console.groq.com
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Optional Configurations
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=text-embedding-004
REFERENCE_DATE=2025-01-15
